#!/bin/sh

DEFAULT_LAN_IP="10.10.10.1"
DEFAULT_LAN_NETMASK="255.255.255.0"
LEGACY_DEFAULT_LAN_IPS="192.168.1.1 192.168.2.1"
RC_COMMON="/rom/etc/rc.common"

log_msg() {
  logger -t "yushu-default-lan" "$1" 2>/dev/null || true
}

run_init_script() {
  local name="$1"
  shift
  local script="/etc/init.d/$name"

  [ -f "$script" ] || return 127

  if [ -f "$RC_COMMON" ]; then
    /bin/sh "$RC_COMMON" "$script" "$@"
    return $?
  fi

  "$script" "$@"
}

is_legacy_default_lan_ip() {
  local ip="$1"
  local legacy=""

  [ -n "$ip" ] || return 0
  [ "$ip" = "$DEFAULT_LAN_IP" ] && return 1

  for legacy in $LEGACY_DEFAULT_LAN_IPS; do
    [ "$ip" = "$legacy" ] && return 0
  done

  return 1
}

sync_router_dns_records() {
  local lan_ip="$1"
  local dnsmasq_section=""
  local host=""
  local stale_ip=""

  dnsmasq_section=$(uci show dhcp 2>/dev/null | awk -F'[.=]' '/=dnsmasq$/ {print $2; exit}')
  [ -n "$dnsmasq_section" ] || return 0

  for host in yushu-router ysrouter; do
    uci -q del_list dhcp.${dnsmasq_section}.cname=${host},yushu-router 2>/dev/null || true
    for stale_ip in $DEFAULT_LAN_IP $LEGACY_DEFAULT_LAN_IPS "$lan_ip"; do
      [ -n "$stale_ip" ] || continue
      uci -q del_list dhcp.${dnsmasq_section}.address=/${host}/${stale_ip} 2>/dev/null || true
      uci -q del_list dhcp.${dnsmasq_section}.address=/${host}.lan/${stale_ip} 2>/dev/null || true
      uci -q del_list dhcp.${dnsmasq_section}.hostrecord=${host},${stale_ip} 2>/dev/null || true
    done
  done

  uci -q delete dhcp.yushu_router_hostrecord 2>/dev/null || true
  uci -q delete dhcp.ysrouter_hostrecord 2>/dev/null || true

  uci add_list dhcp.${dnsmasq_section}.address=/yushu-router/${lan_ip}
  uci add_list dhcp.${dnsmasq_section}.address=/yushu-router.lan/${lan_ip}
  uci set dhcp.yushu_router_hostrecord=hostrecord
  uci set dhcp.yushu_router_hostrecord.name=yushu-router
  uci set dhcp.yushu_router_hostrecord.ip=${lan_ip}

  uci add_list dhcp.${dnsmasq_section}.address=/ysrouter/${lan_ip}
  uci add_list dhcp.${dnsmasq_section}.address=/ysrouter.lan/${lan_ip}
  uci set dhcp.ysrouter_hostrecord=hostrecord
  uci set dhcp.ysrouter_hostrecord.name=ysrouter
  uci set dhcp.ysrouter_hostrecord.ip=${lan_ip}

  uci commit dhcp
}

current_lan_ip=$(uci -q get network.lan.ipaddr 2>/dev/null || true)

if is_legacy_default_lan_ip "$current_lan_ip"; then
  log_msg "moving default LAN from ${current_lan_ip:-unset} to ${DEFAULT_LAN_IP}"
  uci set network.lan.ipaddr="$DEFAULT_LAN_IP"
  uci set network.lan.netmask="$DEFAULT_LAN_NETMASK"
  uci commit network
  sync_router_dns_records "$DEFAULT_LAN_IP"
  run_init_script network reload 2>/dev/null || true
  run_init_script dnsmasq restart 2>/dev/null || true
else
  sync_router_dns_records "$current_lan_ip"
  run_init_script dnsmasq restart 2>/dev/null || true
fi

exit 0
